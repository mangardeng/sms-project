# Copy this file to .env and fill in real values. Never commit the real .env file.

DJANGO_SECRET_KEY=change-this-to-a-long-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# MySQL database configuration
DB_ENGINE=django.db.backends.mysql
DB_NAME=school_management_db
DB_USER=school_admin
DB_PASSWORD=change-this-password
DB_HOST=127.0.0.1
DB_PORT=3306

# CORS - React frontend origin(s), comma separated
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# JWT lifetimes (minutes / days)
ACCESS_TOKEN_LIFETIME_MIN=30
REFRESH_TOKEN_LIFETIME_DAYS=7
